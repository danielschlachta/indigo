body {
    background-color: #fff6e8;
}

h1 {
	font-size: 210%;
}

h2 {
	font-size: 140%;
}

p {
	margin-top: 0.8em;
}

li {
	margin-bottom: 1em;
}

li > p {
	margin: 0.3em 0 0.5em 0;
}

blockquote {
    margin: 0;
    margin-bottom: -5px;
}

blockquote > img {
    float: left;
    height: 4em;
    padding-right: 0.8em; 
    padding-bottom: 5px;
    margin-top: 5px;
}

pre {
    margin: 0;
    padding: 0;
}

code {
    font-family: 'Lekton';
    font-weight: bold;
}

nav {
	background-color: #ffe7d6;
}

header {
    background: #b1b390;
}

#caption {
    font-size: 250%;
	font-weight: normal;
}

aside {
	background-color: #bdd5c4;
}

article {
	background-color: #ebd8b9;
}

article > a {
	text-decoration: underline;
	color: inherit;
	transition:.2s;
}

article > a:hover {
    background-color: #e1c0bc;
}

footer {
    background-color: #a2acbd;
}

footer a {
	font-family: inherit;
	color: inherit;
	text-decoration: none;
	border-bottom: 1px dotted black;
}

footer a:hover {
	border-bottom: 1px solid black;
}

