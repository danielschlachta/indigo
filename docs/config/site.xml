<?xml version="1.0" encoding="utf-8"?>
<site name="indigo"	content-language="en" index-document="main/home">

	<folder id="main" name="Main" show-name="no">
		<document id="home"
			name="Home"
			description="Welcome to indigo"
			navigation-comment="The page of pages">

            <attribute name="image">
                <option name="src">main/home/images/randomsymbols.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>
            
		    <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Latest news from CNN; rss: http://rss.cnn.com/rss/cnn_latest.rss; maxitems: 1
			    <!-- caption: Excuse of the day; rss: https://meyerweb.com/feeds/excuse/rss20.xml; maxitems: 1 -->
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/home/home.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
   		    <datasource name="readme_src"
			    class="idg_datasource_textfile">
			    filename: ../README.md
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_markdown"
			    source="readme_src" />
	    </document>

	    <document id="about"
			name="About"
			description="What it's about">

            <attribute name="image">
                <option name="src">main/about/images/fractal.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>		    
            
            <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Quick Links; links: main/about/about.html
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/about/about.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
	    </document>

	    <document id="designs"
			name="Designs"
			description="The old switcheroo">

            <attribute name="image">
                <option name="src">main/desings/images/none.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>		    

		    <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Choose your poison; file: infobox.html
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/designs/designs.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
	    </document>
    </folder>

	<folder id="resources" name="Resources" show-name="no">
	    <xi:include 
	        href="http://cortes.schlachta.local/~daniel/indigo/docs/resources/tutorial/tutorial.xml"
	        xmlns:xi="http://www.w3.org/2003/XInclude" />

   	    <document id="reference" 
   	        name="Reference" 
   	        description="Further Reading">
   	        
            <attribute name="image">
                <option name="src">resources/reference/images/telescope.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>		    

		    <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Quick Links; links: resources/license/license.html
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: resources/reference/reference.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
        </document>

        <document id="examples" 
            name="Examples" 
            description="Stuff you can use">
            
            <attribute name="image">
                <option name="src">resources/examples/images/none.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>		    		    
            
            <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Quick Links; links: resources/license/license.html
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: resources/examples/examples.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
        </document>

   	    <document id="license" 
   	        name="License" 
   	        description="Legalese">
   	        
		    <attribute name="image">
                <option name="src">resources/reference/images/none.jpg</option>
                <option name="width">90px</option>
                <option name="height">90px</option>
            </attribute>		    
            
		    <datasource name="infobox"
			    class="idg_datasource_blocks_infobox">
			    caption: Quick Links; links: resources/license/license.html
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: resources/license/license.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />
        </document>
    </folder>
</site>
