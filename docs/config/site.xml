<?xml version="1.0" encoding="utf-8"?>
<site name="indigo"
	content-language="en"
	title-separator=" - "
	index-document="main/home">  
	   
	<folder id="main" show-name="no">
		<document id="home" 
			name="Home" 
			description="Welcome to indigo" 
			navigation-comment="The page of pages">
		    <datasource name="framedimg"
			    class="idg_datasource_framedimg">
			    file: randomsymbols.jpg; width: 90; height: 90;
		    </datasource>
		    <datasource name="infobox"
			    class="idg_datasource_infobox">
			    caption: Latest news from CNN; rss: http://rss.cnn.com/rss/cnn_latest.rss; maxitems: 1
			    <!-- caption: Excuse of the day; rss: https://meyerweb.com/feeds/excuse/rss20.xml; maxitems: 1 -->
		    </datasource>

		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/home/home.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />			    
   		    <datasource name="readme_src"
			    class="idg_datasource_textfile">
			    filename: ../README.md
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_markdown"
			    source="readme_src" />		
		    <datasource name="text2_src"
			    class="idg_datasource_textfile">
			    filename: main/home/flourish.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text2_src" />		
	    </document>
	    <document id="about" 
			name="About" 
			description="What it's about">
		    <datasource name="framedimg"
			    class="idg_datasource_framedimg">
			    file: fractal.jpg; width: 90; height: 90;
		    </datasource>
		    <datasource name="infobox"
			    class="idg_datasource_infobox">
			    caption: Quick Links; links: main/about/about.html
		    </datasource>
		    
		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/about/about.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />		
	    </document>
	    <document id="designs" 
			name="Designs" 
			description="The old switcheroo">
		    <datasource name="framedimg"
			    class="idg_datasource_framedimg">
			    file: me.jpg; width: 90; height: 90;
		    </datasource>
		    <datasource name="infobox"
			    class="idg_datasource_infobox">
			    caption: Choose your poison; file: infobox.html
		    </datasource>
		    
		    <datasource name="text1_src"
			    class="idg_datasource_textfile">
			    filename: main/designs/designs.html
		    </datasource>
		    <renderer slot="main-text"
			    class="idg_view_html_renderer_textfile"
			    source="text1_src" />		
	    </document>
    </folder>  

