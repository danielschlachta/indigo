<?xml version="1.0" encoding="utf-8"?>
<site name="indigo"	content-language="en" index-document="main/home">
    <attribute name="blocks::image">
        <option name="src">pages/main/home/randomsymbols.jpg</option>
    </attribute>

    <folder id="main" name="Main" show-name="no">
        <document id="home"
                  name="Home"
                  description="Welcome to indigo"
                  navigation-comment="The page of pages">

            <attribute name="blocks::image">
                <option name="src">pages/main/home/randomsymbols.jpg</option>
            </attribute>
            
            <datasource name="infobox"
                        class="Indigo\Datasource\rss">
                <parameter name="type">rss</parameter>
                <parameter name="url">https://meyerweb.com/feeds/excuse/rss20.xml</parameter>
                <parameter name="max-items">1</parameter>
                <parameter name="reverse">yes</parameter>
            </datasource>
            <attribute name="blocks::infobox">
                <option name="caption">Procrastination</option>
            </attribute>
            
            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/main/home/home.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
            <datasource name="readme_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">../README.md</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Module\Markdown\renderer"
                      source="readme_src" />
        </document>

        <document id="about"
                  name="About"
                  description="What it's about">

            <attribute name="blocks::image">
                <option name="src">pages/main/about/fractal.jpg</option>
            </attribute>

            <datasource name="infobox"
                        class="Indigo\Datasource\text">
                <parameter name="filename">pages/main/about/about.html</parameter>
            </datasource>

            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/main/about/about.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
        </document>

        <document id="designs"
                  name="Designs"
                  description="The old switcheroo">

            <!-- <attribute name="blocks::image">
                <option name="src">pages/main/desings/none.jpg</option>
            </attribute> -->

            <datasource name="infobox"
                        class="Indigo\Datasource\text">
                <parameter name="filename">pages/main/designs/infobox.html</parameter>
            </datasource>

            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/main/designs/designs.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
        </document>
    </folder>

    <folder id="resources" name="Resources" show-name="no">
        <attribute name="image">
            <option name="src">pages/resources/tutorial/sneakers.jpg</option>
        </attribute>

        <xi:include
            href="pages/resources/tutorial/tutorial.xml"
            xmlns:xi="http://www.w3.org/2003/XInclude" />
        
            <document id="reference"
                  name="Reference"
                  description="Further Reading">

            <attribute name="blocks::image">
                <option name="src">pages/resources/reference/telescope.jpg</option>
            </attribute>

            <datasource name="infobox"
                        class="Indigo\Datasource\text">
                <parameter name="filename">pages/resources/license/license.html</parameter>
            </datasource>

            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/resources/reference/reference.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
        </document>

        <document id="examples"
                  name="Examples"
                  description="Stuff you can use">

            <!--<attribute name="blocks::image">
                <option name="src">pages/resources/examples/none.jpg</option>
            </attribute>-->

            <datasource name="infobox"
                        class="Indigo\Datasource\text">
                <parameter name="filename">pages/resources/license/license.html</parameter>
            </datasource>

            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/resources/examples/examples.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
        </document>

        <document id="license"
                  name="License"
                  description="Legalese">

            <!--<attribute name="blocks::image">
                <option name="src">pages/resources/reference/none.jpg</option>
            </attribute>-->

            <datasource name="infobox"
                        class="Indigo\Datasource\text">
                <parameter name="filename">pages/resources/license/license.html</parameter>
            </datasource>

            <datasource name="text1_src"
                        class="Indigo\Datasource\textfile">
                <parameter name="filename">pages/resources/license/license.html</parameter>
            </datasource>
            <renderer slot="main-text"
                      class="Indigo\Renderer\textfile"
                      source="text1_src" />
        </document>
    </folder>
</site>
