a > img {
    height: 0.6em;
    padding: 0 0.3em 0 0.3em;
    margin-top: -0.1em;
}

h1 {
	font-size: 210%;
	margin: 0;
}

h2 {
	font-size: 140%;
	margin: 0;
}

p {
	margin-top: 0.8em;
}

li {
	margin-bottom: 1em;
}

li > p {
	margin: 0.3em 0 0.5em 0;
}

blockquote {
    margin: 0;
    margin-bottom: -5px;
}

blockquote > img {
    float: left;
    height: 4em;
    padding-right: 0.8em; 
    padding-bottom: 5px;
    margin-top: 5px;
}

pre {
    margin: 0;
    padding: 0;
}

code {
    font-family: 'Lekton';
    font-weight: bold;
}

.content a {
	text-decoration: underline;
	color: inherit;
	transition:.2s;
}

.content a:hover {
    background: #e1c0bc;
}

#footer-text {
	padding-top: 5px;
	width: 100%;
	text-align: right;
	font-size: 80%;
}

#footer-text a {
	font-family: inherit;
	color: #101010;
	text-decoration: none;
	border-bottom: 1px dotted black;
}

#footer-text a:hover {
	border-bottom: 1px solid black;
}
